# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# impeccable
/.impeccable
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# media — served from MEDIA_ROOT (see src/lib/media.ts), never from public/
/public/tts-cache/
/public/video/

# learner photo uploads — small static images, served straight from public/
# (unlike the video/tts media above, no Range support or GB-scale growth to
# worry about), but still user-uploaded content that shouldn't be committed.
/public/uploads/
